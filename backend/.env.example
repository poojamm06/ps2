# NAWI TRUST Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/nawi_trust

# API settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# CORS — comma-separated origins allowed to call this API
# The Vite dev server default is http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
