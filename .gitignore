# ==========================================
# Environment & Secrets (Never commit credentials!)
# ==========================================
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.crt

# ==========================================
# Node / Frontend (Vite + React)
# ==========================================
node_modules/
dist/
dist-ssr/
build/
*.local
.npm/
.eslintcache
*.tsbuildinfo

# Coverage & test artifacts
coverage/
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Python / Backend (FastAPI)
# ==========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Virtual Environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/env/
backend/.venv/

# Testing, Linting & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Local databases and SQLite
*.sqlite
*.sqlite3
*.db
backend/*.db
backend/*.sqlite3

# Uploaded / Generated evidence files & local storage
backend/storage/
backend/app/storage/evidence/*
!backend/app/storage/evidence/.gitkeep
uploads/
storage/

# Large ML / OCR Models & Weights (exceeds GitHub 100MB file limit)
*.onnx
*.pt
*.pth
*.bin
*.weights
models/

# ==========================================
# Operating System & IDEs
# ==========================================
# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# Temporary & backup files
*.tmp
*.temp
*.bak
*~
